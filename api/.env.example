# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-app

# Email d'envoi
EMAIL_FROM=noreply@campusmaster.edu

# URL frontend pour les liens de réinitialisation
FRONTEND_URL=http://localhost:3000

# Configuration WebSocket CORS (séparez plusieurs URLs par des virgules)
WEBSOCKET_CORS_ORIGINS=http://localhost:3000,http://192.168.56.1:3000

# Secrets JWT (obligatoires en production)
JWT_ACCESS_SECRET=votre-access-secret-tres-long-et-unique
JWT_REFRESH_SECRET=votre-refresh-secret-tres-long-et-unique

# Durée de validité des tokens (optionnel)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
