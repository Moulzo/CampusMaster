// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum NotificationType {
  NEW_ASSIGNMENT
  NEW_GRADE
  DEADLINE_REMINDER
  ANNOUNCEMENT
  SYSTEM
  NEW_MESSAGE
}

enum ResourceType {
  FILE
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  fullName          String
  passwordHash      String
  role              Role          @default(STUDENT)
  refreshTokenHash  String?
  resetTokenHash    String?
  resetTokenExpires DateTime?

  // Module affecté (pour les étudiants)
  learningModule      LearningModule?  @relation("ModuleStudents", fields: [learningModuleId], references: [id])
  learningModuleId    String?

  // Relations
  coursesEnrolled     Course[]      @relation("StudentCourses")
  assignmentsCreated  Assignment[]  @relation("TeacherAssignments")
  submissions         Submission[]
  notifications       Notification[]
  courseResources     CourseResource[]
  resourceDownloadEvents ResourceDownloadEvent[]
  resourceViewEvents     ResourceViewEvent[]

  // Annonces créées par l'utilisateur
  announcements      Announcement[] @relation("AnnouncementAuthor")
  
  // Discussions créées par l'utilisateur
  discussionThreads DiscussionThread[]
  discussionMessages DiscussionMessage[]

  // ✅ Cours où l'user est prof (many-to-many)
  teachingCourses     Course[]      @relation("CourseTeachers")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

// PostgreSQL gère nativement les enums avec l'enum Role ci-dessus

model Semester {
  id          String   @id @default(cuid())
  name        String   // ex: "S1 2025-2026"
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learningModules     LearningModule[]
}

model LearningModule {
  id          String   @id @default(cuid())
  name        String   // ex: "Data", "Informatique"
  description String?
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId  String

  subjects    Course[] // les "matières"
  students    User[]   @relation("ModuleStudents") // ✅ étudiants affectés à ce module
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id                 String   @id @default(cuid())
  title              String
  description        String?

  // Rattacher la matière à un module
  learningModule     LearningModule? @relation(fields: [learningModuleId], references: [id], onDelete: SetNull)
  learningModuleId   String?

  // ✅ Profs (many-to-many)
  teachers           User[]   @relation("CourseTeachers")

  // Étudiants inscrits (many-to-many)
  students           User[]   @relation("StudentCourses")

  // Annonces du cours
  announcements      Announcement[] @relation("CourseAnnouncements")
  
  // Discussions du cours
  discussionThreads DiscussionThread[]

  assignments        Assignment[]
  courseResources    CourseResource[]
  resourceDownloadEvents ResourceDownloadEvent[]
  resourceViewEvents     ResourceViewEvent[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  maxScore    Int      @default(20)
  attachmentUrl      String?
  attachmentName     String?
  attachmentSize     Int?
  attachmentMimeType String?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  teacher     User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  
  submissions Submission[]
  notifications Notification[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Submission {
  id            String   @id @default(cuid())
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId  String
  
  fileUrls      String?  // JSON array of file objects
  score         Float?   // 0-20
  feedback      String?
  submittedAt   DateTime @default(now())
  correctedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  files         SubmissionFile[]
  
  @@unique([studentId, assignmentId])
}

model SubmissionFile {
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  
  filename      String   // Original filename
  fileUrl       String   // Path to uploaded file
  fileSize      Int      // File size in bytes
  mimeType      String   // File MIME type
  
  createdAt     DateTime @default(now())
  
  @@id([submissionId, filename])
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  readAt      DateTime?        // ✅ AJOUT
  metadata    Json?            // ✅ AJOUT
  
  // Relations
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Optional: link to related entity
  assignmentId String?
  assignment   Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@index([userId, isRead])
  @@index([createdAt])
}

model CourseResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        ResourceType @default(FILE)

  // stockage local
  filename    String   // nom affiché ou original
  storedName  String   // nom unique généré (safe)
  mimeType    String
  size        Int
  path        String   // chemin relatif (ex: "courses/<courseId>/<storedName>")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String

  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  downloadEvents ResourceDownloadEvent[]
  viewEvents     ResourceViewEvent[]

  @@index([courseId])
  @@index([teacherId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String

  courseId  String
  course    Course   @relation("CourseAnnouncements", fields: [courseId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([authorId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  title     String
  
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String

  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  messages  DiscussionMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([createdById])
}

model DiscussionMessage {
  id        String   @id @default(cuid())
  content   String

  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([authorId])
}

model ResourceDownloadEvent {
  id           String   @id @default(cuid())
  resourceId   String
  courseId     String
  userId       String
  downloadedAt DateTime @default(now())

  resource CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([courseId])
  @@index([userId])
  @@index([downloadedAt])
}

model ResourceViewEvent {
  id        String   @id @default(cuid())
  resourceId String
  courseId   String
  userId     String
  viewedAt   DateTime @default(now())

  resource CourseResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([courseId])
  @@index([userId])
  @@index([viewedAt])
}
