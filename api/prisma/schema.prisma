// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum NotificationType {
  NEW_ASSIGNMENT
  NEW_GRADE
  DEADLINE_REMINDER
  ANNOUNCEMENT
  SYSTEM
  NEW_MESSAGE
}

enum ResourceType {
  FILE
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  fullName          String
  passwordHash      String
  role              Role          @default(STUDENT)
  refreshTokenHash  String?
  resetTokenHash    String?
  resetTokenExpires DateTime?
  
  // Relations
  coursesCreated    Course[]      @relation("TeacherCourses")
  coursesEnrolled   Course[]      @relation("StudentCourses")
  assignmentsCreated Assignment[] @relation("TeacherAssignments")
  submissions       Submission[]
  notifications     Notification[]
  courseResources   CourseResource[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// PostgreSQL gère nativement les enums avec l'enum Role ci-dessus

model Semester {
  id          String   @id @default(cuid())
  name        String   // ex: "S1 2025-2026"
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  learningModules     LearningModule[]
}

model LearningModule {
  id          String   @id @default(cuid())
  name        String   // ex: "Data", "Informatique"
  description String?
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId  String

  subjects    Course[] // les "matières"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?

  // ✅ nouveau : rattacher la matière à un module
  learningModule      LearningModule?  @relation(fields: [learningModuleId], references: [id], onDelete: SetNull)
  learningModuleId    String?

  teacher     User     @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  
  // Many-to-many: students enrolled in this course
  students    User[]   @relation("StudentCourses")
  
  assignments Assignment[]
  courseResources CourseResource[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  maxScore    Int      @default(20)
  attachmentUrl      String?
  attachmentName     String?
  attachmentSize     Int?
  attachmentMimeType String?
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  teacher     User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  
  submissions Submission[]
  notifications Notification[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Submission {
  id            String   @id @default(cuid())
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId  String
  
  fileUrls      String?  // JSON array of file objects
  score         Float?   // 0-20
  feedback      String?
  submittedAt   DateTime @default(now())
  correctedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  files         SubmissionFile[]
  
  @@unique([studentId, assignmentId])
}

model SubmissionFile {
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId  String
  
  filename      String   // Original filename
  fileUrl       String   // Path to uploaded file
  fileSize      Int      // File size in bytes
  mimeType      String   // File MIME type
  
  createdAt     DateTime @default(now())
  
  @@id([submissionId, filename])
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  readAt      DateTime?        // ✅ AJOUT
  metadata    Json?            // ✅ AJOUT
  
  // Relations
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Optional: link to related entity
  assignmentId String?
  assignment   Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@index([userId, isRead])
  @@index([createdAt])
}

model CourseResource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        ResourceType @default(FILE)

  // stockage local
  filename    String   // nom affiché ou original
  storedName  String   // nom unique généré (safe)
  mimeType    String
  size        Int
  path        String   // chemin relatif (ex: "courses/<courseId>/<storedName>")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String

  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([teacherId])
}
